
GITHUB_TOKEN=your_github_token_here

# GitHub App OAuth Broker
GITHUB_APP_CLIENT_ID=your_github_app_client_id
GITHUB_APP_CLIENT_SECRET=your_github_app_client_secret
# Local single-user callback. Use an HTTPS URL for a remote deployment.
BROKER_CALLBACK_URL=http://127.0.0.1:8000/auth/callback
BROKER_REQUEST_TIMEOUT=30

# Broker URL (CLI and web dashboard)
BROKER_URL=http://127.0.0.1:8000

# Broker rate limiting (optional)
BROKER_RATE_LIMIT_ENABLED=true
BROKER_RATE_LIMIT_WINDOW_SECONDS=60
BROKER_RATE_LIMIT_START_PER_IP=60
BROKER_RATE_LIMIT_CALLBACK_PER_IP=120
BROKER_RATE_LIMIT_POLL_PER_IP=240
BROKER_RATE_LIMIT_POLL_PER_TRANSACTION=60
BROKER_RATE_LIMIT_ACK_PER_IP=60
BROKER_RATE_LIMIT_ACK_PER_TRANSACTION=10
BROKER_RATE_LIMIT_FAILURES_PER_IP=30

# Comma-separated reverse-proxy IPs/CIDRs allowed to set X-Forwarded-For.
# Leave empty for direct loopback access.
BROKER_TRUSTED_PROXIES=


# Redirect browser to dashboard after successful GitHub callback (optional)
BROKER_DASHBOARD_URL=http://127.0.0.1:8001/dashboard

# Web session cookie Secure flag: auto (scheme-based, default for loopback), true, false
COOKIE_SECURE=auto

